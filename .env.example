# LLM provider (any OpenAI-compatible chat API). Choose ONE base URL.

# Gemini (OpenAI-compatible endpoint):
# Check Google's current model list for a tool-calling-enabled model
# and set LLM_BASE_URL and LLM_MODEL accordingly.
# Example (replace with current model name):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=models/gemini-1.5-flash  # <- update to current model

# Groq alternative:
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-key
LLM_MODEL=openai/gpt-oss-20b

# Maximum ReAct reasoning steps before the agent stops (default: 8)
MAX_STEPS=8